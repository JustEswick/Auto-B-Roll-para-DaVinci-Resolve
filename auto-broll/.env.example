# API Keys para servicios externos
# Copia este archivo a .env y completa con tus claves

# Pexels - https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay - https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Unsplash - https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# OpenAI (opcional, para mejoras con GPT)
OPENAI_API_KEY=

# Google Cloud Speech-to-Text (opcional, fallback)
GOOGLE_APPLICATION_CREDENTIALS=
